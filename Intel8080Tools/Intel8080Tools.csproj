<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <LangVersion>12</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Title>Intel8080Tools</Title>
        <Description>An emulator for the Intel8080 CPU</Description>
        <RepositoryUrl>https://github.com/NilEis/Intel8080Tools</RepositoryUrl>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Copyright>MIT</Copyright>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Authors>Nils Eisenach</Authors>
        <Version>1.0.6</Version>
        <TargetFrameworks>net8.0;net10.0;net9.0</TargetFrameworks>
        <PackageProjectUrl>https://github.com/NilEis/Intel8080Tools</PackageProjectUrl>
        <PackageLicenseUrl></PackageLicenseUrl>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../LICENSE" Pack="true" PackagePath=""/>
        <None Include="../README.md" Pack="true" PackagePath=""/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Sprache" Version="3.0.0-develop-00049"/>
    </ItemGroup>
    <ItemGroup>
      <Content Include="C:\Users\NilEis\Desktop\cpudiag.asm">
        <Link>cpudiag.asm</Link>
      </Content>
    </ItemGroup>

</Project>
